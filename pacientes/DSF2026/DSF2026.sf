   "title": "Problema activo: TEP / Tromboembolismo pulmonar",
   "text": "CIE-10-ES I26.99 - Other pulmonary embolism without acute cor pulmonale",
   "pdf_id": "PDF009",
   "prc_id": "PRC009"
  },
  {
   "date": "2022-01-07",
   "type": "consulta",
   "title": "TEP / TROMBOEMBOLISMO PULMONAR",
   "text": "I26.99 CIE-10-ES — Problema activo",
   "pdf_id": "PDF001",
