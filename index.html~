      el.querySelector('.hex-sub').textContent=t.sub;
      el.querySelector('.hex-sub').style.fontSize=subSize+'px';
      el.onclick=(function(idx){return function(){cellClick(idx)}})(i);   /* cellClick lit ACTIVE */
    });
  },500);
  /* Phase 3: réapparition progressive + dégonflement */
  setTimeout(function(){
    hexEls.forEach(function(el){
      el.style.transform='scale(1)';
      el.style.opacity='1';
    });
  },600);
  /* Phase 4: reset */
  setTimeout(function(){
    hexEls.forEach(function(el){el.style.transition='all .3s'});
    _isMain=!_isMain;
  },1400);
}

