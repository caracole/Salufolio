var _isMain=true;
function swapHive(){
  var hexEls=document.querySelectorAll('.hex');
  var target=_isMain?SUB:CELLS;
  /* Phase 1: gonflement + disparition progressive */
  hexEls.forEach(function(el){
    el.style.transition='transform .8s ease, opacity .6s ease';
    el.style.transform='scale(1.08)';
    el.style.opacity='0.15';
  });
  /* Phase 2: changer le contenu (invisible) */
  setTimeout(function(){
    ACTIVE=target;                       /* l'essaim actif change ICI, avec le contenu */
    var R=R0;
