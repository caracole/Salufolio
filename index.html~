<script>
/* ══ PolygoneReg ══ */
class PolygoneReg{
  constructor(n,R,rot){this.n=n;this.R=R;this.a=2*R*Math.sin(Math.PI/n);this.r=R*Math.cos(Math.PI/n);this.rotation=rot||0}
  vertices(cx,cy){var p=[],r=this.rotation*Math.PI/180;for(var i=0;i<this.n;i++){var a=2*Math.PI*i/this.n+r;p.push({x:cx+this.R*Math.cos(a),y:cy+this.R*Math.sin(a)})}return p}
  svgPoints(cx,cy){return this.vertices(cx,cy).map(function(p){return(Math.round(p.x*10)/10)+','+(Math.round(p.y*10)/10)}).join(' ')}
  static fit(aW,aH,n,rot){var t=new PolygoneReg(n,100,rot),v=t.vertices(0,0),xs=v.map(function(p){return p.x}),ys=v.map(function(p){return p.y});var tw=Math.max.apply(null,xs)-Math.min.apply(null,xs),th=Math.max.apply(null,ys)-Math.min.apply(null,ys);return new PolygoneReg(n,100*Math.min(aW/tw,aH/th),rot)}
}
class Hexagon extends PolygoneReg{
  constructor(R,o){super(6,R,o==='flat'?0:-90);this.orientation=o||'pointy'}
  static fit(aW,aH,o){return new Hexagon(PolygoneReg.fit(aW,aH,6,o==='flat'?0:-90).R,o)}
}
</script>

<script>
/* ══ SVG artistique ══ */
function hexSVG(R,cx,cy,color,orient,id){
  var hex=new Hexagon(R,orient),pts=hex.svgPoints(cx,cy),g='g_'+id,gl='gl_'+id;
  var s='<defs><radialGradient id="'+g+'" cx="50%" cy="40%" r="65%"><stop offset="0%" stop-color="'+color+'" stop-opacity=".3"/><stop offset="100%" stop-color="'+color+'" stop-opacity=".06"/></radialGradient>';
  s+='<filter id="'+gl+'"><feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>';
  s+='<polygon points="'+pts+'" fill="rgba(0,0,0,.25)" transform="translate(1.5,2.5)"/>';
  s+='<polygon points="'+pts+'" fill="url(#'+g+')" stroke="'+color+'" stroke-width="1.8" filter="url(#'+gl+')"/>';
  var v=hex.vertices(cx,cy);
  s+='<polygon points="'+v.slice(0,3).concat([{x:cx,y:cy}]).map(function(p){return Math.round(p.x)+','+Math.round(p.y)}).join(' ')+'" fill="rgba(255,255,255,.03)"/>';
  var inn=new Hexagon(R*.91,orient);
  s+='<polygon points="'+inn.svgPoints(cx,cy)+'" fill="none" stroke="'+color+'" stroke-width=".4" opacity=".25"/>';
  return s;
}
</script>

