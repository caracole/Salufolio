   d'homothétie), le centre reste le centre, le texte suit exactement. */
var R0=120, _zoom=1;
/* Découverte de P-H (17/07) officialisée : Maj+molette règle la taille du
   texte DANS l'alvéole ouverte — et nulle part ailleurs. Gravée dans le code
   pour marcher pareil sur toute machine ; mémorisée entre les visites. */
var _txtZoom=parseFloat(localStorage.getItem('panal_txtzoom')||'1');
function aplicarTxtZoom(){
  var b=document.getElementById('pop-body');
  if(b)b.style.zoom=_txtZoom;
  try{localStorage.setItem('panal_txtzoom',_txtZoom)}catch(e){}
}
function fitHive(){
  var hive=document.getElementById('hive');
  var S3=Math.sqrt(3);
  var visW=3*S3*R0, visH=5*R0;              /* dimensions visuelles de référence */
  var r=hive.parentElement.getBoundingClientRect();   /* le hublot, fixe à l'écran */
  var k=Math.min((r.height-8)/visH, (r.width-8)/visW)*_zoom;   /* LE rapport d'homothétie */
  hive.style.transform='translate(-50%,-50%) scale('+k+')';
  /* le hublot ne bouge pas : l'essaim se dilate en son centre, le débord est
     rogné pareillement des quatre côtés — l'alvéole centrale reste au centre */
}

function buildHive(){
  var el=document.getElementById('hive');
  el.innerHTML='';
  var R=R0;                                  /* taille de référence — l'écran n'entre plus ici */
  var S3=Math.sqrt(3);
  var sp=1; /* espacement entre centres (1=collés) */
  var hexW=S3*R, hexH=2*R;
  var totalW=3*S3*R*sp+S3*R, totalH=5*R*sp;
  var cx=totalW/2, cy=totalH/2;
  var positions=[
    /* Rangée 0: 2 hexagones */
    {x:cx-S3*R*sp/2, y:cy-1.5*R*sp},
    {x:cx+S3*R*sp/2, y:cy-1.5*R*sp},
    /* Rangée 1: 3 hexagones */
    {x:cx-S3*R*sp,   y:cy},
    {x:cx,            y:cy},       /* CENTRE */
    {x:cx+S3*R*sp,   y:cy},
    /* Rangée 2: 2 hexagones */
    {x:cx-S3*R*sp/2, y:cy+1.5*R*sp},
    {x:cx+S3*R*sp/2, y:cy+1.5*R*sp}
  ];
  el.style.width=Math.round(totalW)+'px';
  el.style.height=Math.round(totalH)+'px';
  fitHive();                                 /* projection homothétique immédiate */

  for(var i=0;i<ACTIVE.length;i++){
    var c=ACTIVE[i],pos=positions[i];
    var div=document.createElement('div');
    div.className='hex'+(i===3?' center':'');
    div.dataset.cell=c.id||'';
    div.style.left=Math.round(pos.x-hexW/2)+'px';
    div.style.top=Math.round(pos.y-hexH/2)+'px';
    div.style.width=Math.round(hexW)+'px';
    div.style.height=Math.round(hexH)+'px';
    div.onclick=(function(idx){return function(){cellClick(idx)}})(i);
    /* Tailles adaptatives */
    var icoSize=Math.max(20,Math.round(R/2.5));
    var lblSize=Math.max(12,Math.round(R/5));
    var subSize=Math.max(9,Math.round(R/7));
    if(i===3){icoSize=Math.round(icoSize*1.3);lblSize=Math.round(lblSize*1.3)}
    var svgContent=hexSVG(R,hexW/2,hexH/2,c.color,'pointy','g'+i);
    div.innerHTML='<svg viewBox="0 0 '+Math.round(hexW)+' '+Math.round(hexH)+'" style="width:100%;height:100%;position:absolute">'+svgContent+'</svg>'
      +'<div class="hex-ct"><span class="hex-ico" style="font-size:'+icoSize+'px">'+(c.icon||'')+'</span><span class="hex-lbl" style="font-size:'+lblSize+'px">'+(c.label||'')+'</span><span class="hex-sub" style="font-size:'+subSize+'px">'+(ptr(c,'sub')||'')+'</span></div>';
    el.appendChild(div);
  }
  /* L'ABEILLE (P-H 19/07, spec du triangle isocèle : encoche du bas,
     b + h/2 → (cx, cy+2R+R/4)) — créée APRÈS les alvéoles et z-index roi :
     les boîtes rectangulaires des hexagones voisins ne la couvrent plus. */
  var bee=document.createElement('div');
  bee.className='bee-swap';
  bee.textContent='🐝';
  bee.title='Cambiar de panal';
  bee.onclick=function(ev){ev.stopPropagation();swapHive();};
  bee.style.left=Math.round(cx)+'px';
  bee.style.top=Math.round(cy + 2*R + R/4)+'px';
  el.appendChild(bee);
}

