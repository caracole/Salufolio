  var v=hex.vertices(0,0),xs=v.map(function(p){return p.x}),ys=v.map(function(p){return p.y});
  var w=Math.max.apply(null,xs)-Math.min.apply(null,xs),h=Math.max.apply(null,ys)-Math.min.apply(null,ys);
  var cx=w/2,cy=h/2;
